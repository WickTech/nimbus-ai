{
  "name": "nimbus-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack AI SaaS starter: streaming LLM chat with auth, persistence, and usage-based credit billing.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.20",
    "@auth/prisma-adapter": "^2.11.3",
    "@langfuse/otel": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@prisma/client": "^6.2.1",
    "@stripe/stripe-js": "^10.2.0",
    "ai": "^4.0.30",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "stripe": "^23.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
