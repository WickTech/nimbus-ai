# --- Database (SQLite for local dev; swap to Postgres URL in prod) ---
# connection_limit=1 matters for SQLite: with more connections, simultaneous requests (two chats at once)
# fail with "operation timed out" instead of waiting their turn. Postgres does not need it.
DATABASE_URL="file:./prisma/dev.db?connection_limit=1"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- GitHub OAuth (optional — enables "Sign in with GitHub") ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- LLM provider ---
OPENAI_API_KEY="sk-..."
# Optional: point at any OpenAI-compatible endpoint (Ollama, Together, Groq, etc.)
# OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Billing ---
# Credits granted to a new account on signup.
SIGNUP_FREE_CREDITS="100"

# --- Stripe top-up (optional — leave blank to disable top-up UI) ---
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create one-time payment prices in Stripe Dashboard and paste IDs here.
STRIPE_PRICE_100=""
STRIPE_PRICE_500=""
STRIPE_PRICE_2000=""

# --- Observability (optional — Langfuse LLM tracing) ---
# Leave empty to disable. Keys from https://cloud.langfuse.com (or self-host).
# Traces each chat completion with prompt, output, tokens, latency, user and
# conversation (Langfuse "Users" and "Sessions" views).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"   # EU default; US: https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT="production"        # defaults to NODE_ENV
# Set to "false" to send only metadata/usage, never message content.
# LANGFUSE_RECORD_IO="true"
